{
  "name": "x.wuh.site",
  "version": "1.0.0",
  "private": true,
  "description": "博客项目相关的系列仓库, 全套使用Nextjs搭建",
  "main": "index.js",
  "scripts": {
    "dev:next": "pnpm --filter @wuh.site/next run dev",
    "build:next": "pnpm --filter @wuh.site/next run build",
    "start:next": "pnpm --filter @wuh.site/next run start",
    "lint:next": "pnpm --filter @wuh.site/next run lint",
    "dev:nest": "pnpm --filter @wuh.site/nest run start:dev",
    "build:nest": "pnpm --filter @wuh.site/nest run build",
    "start:nest": "pnpm --filter @wuh.site/nest run start:prod",
    "sync:init": "pnpm --filter @wuh.site/nest run sync:init",
    "prepare": "husky",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0",
    "version:major": "standard-version -r major",
    "version:minor": "standard-version -r minor",
    "version:patch": "standard-version -r patch",
    "release": "pnpm changelog && pnpm version:major"
  },
  "workspaces": [
    "packages/**"
  ],
  "keywords": [
    "wuh.site",
    "blog",
    "吴尒红"
  ],
  "author": "shadow <wuh201314@foxmail.com>",
  "license": "ISC",
  "dependencies": {
    "@wuh.site/components": "workspace:^",
    "classnames": "^2.5.1",
    "conventional-changelog-cli": "^5.0.0",
    "next": "15.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "standard-version": "^9.5.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^8",
    "eslint-config-next": "15.0.4",
    "husky": "^9.1.7",
    "typescript": "^5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "commitlint -E"
    }
  }
}
