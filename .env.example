# MongoDB
MONGO_URI=mongodb://localhost:27017/wuh-site

# GitHub content sync / CMS
GITHUB_PERSONAL_TOKEN=
CONTENT_REPO_OWNER=stack-wuh
CONTENT_REPO_NAME=x.wuh.site

# GitHub webhook 签名 secret（须与内容仓 webhook 配置一致；未配置时 webhook 端点拒绝处理）
GITHUB_WEBHOOK_SECRET=

# GitHub webhook 的 issue 归档事件转发（GH_TOKEN 需对 workflow 仓库有 actions:write；
# 留空则跳过转发，不影响内容同步）
GH_TOKEN=
SHADOW_PROJECT_REPO=stack-wuh/x.wuh.site
SHADOW_WORKFLOW_REPO=stack-wuh/shadow-dev-workflow

# 站点单源 URL（RSS/OG/Swagger 等引用；须与 packages/core 的 SITE_URL 常量一致）
SITE_URL=https://wuh.site

# Sentry 错误上报（生产 5xx 留痕链路；留空则不上报）
SENTRY_DSN=

# 微信读书书架同步凭据（留空则 weread 同步端点不可用）
WEREAD_API_KEY=

# Nest API
PORT=3200
CORS_ORIGIN=http://localhost:3000,http://localhost:3300
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400

# GitHub OAuth for Console
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3200/v2/auth/github/callback
CONSOLE_URL=http://localhost:3300

# 网易云音乐（站点播放器 / 音乐页）
# 网易云歌单 id（缺省 3778678 热歌榜；匿名态实测榜单类歌单可全部返回播放地址）
NETEASE_DEFAULT_PLAYLIST_ID=3778678
# 登录态：填浏览器 cookie 里的 MUSIC_U 值（或整串 cookie）。留空为匿名态——
# 匿名可播榜单/新歌，VIP 与版权受限曲目会返回空地址并被播放器跳过。
NETEASE_MUSIC_U=
# 站点侧默认歌单（构建期注入 NEXT_PUBLIC_ 前缀，改后需重新构建）
NEXT_PUBLIC_NETEASE_PLAYLIST_ID=3778678

# Console SPA
VITE_API_BASE_URL=http://localhost:3200/v2
