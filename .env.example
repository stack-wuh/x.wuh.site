# MongoDB
MONGO_URI=mongodb://localhost:27017/wuh-site

# GitHub content sync / CMS
GITHUB_PERSONAL_TOKEN=
CONTENT_REPO_OWNER=stack-wuh
CONTENT_REPO_NAME=x.wuh.site

# Nest API
PORT=3200
CORS_ORIGIN=http://localhost:3000,http://localhost:3300
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=86400

# GitHub OAuth for Console
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3200/v2/auth/github/callback
CONSOLE_URL=http://localhost:3300

# 网易云音乐（站点播放器 / 音乐页）
# 网易云歌单 id（缺省 3778678 热歌榜；匿名态实测榜单类歌单可全部返回播放地址）
NETEASE_DEFAULT_PLAYLIST_ID=3778678
# 登录态：填浏览器 cookie 里的 MUSIC_U 值（或整串 cookie）。留空为匿名态——
# 匿名可播榜单/新歌，VIP 与版权受限曲目会返回空地址并被播放器跳过。
NETEASE_MUSIC_U=
# 站点侧默认歌单（构建期注入 NEXT_PUBLIC_ 前缀，改后需重新构建）
NEXT_PUBLIC_NETEASE_PLAYLIST_ID=3778678

# Console SPA
VITE_API_BASE_URL=http://localhost:3200/v2
