# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/wuh_site

# GitHub API
GITHUB_PERSONAL_TOKEN=your_github_personal_token
GITHUB_WEBHOOK_SECRET=your_webhook_secret
CONTENT_REPO_OWNER=stack-wuh
CONTENT_REPO_NAME=blog
COMMENT_ISSUE_NUMBER=123

# GitHub OAuth (optional for future auth module)
GITHUB_CLIENT_ID=your_client_id
GITHUB_CLIENT_SECRET=your_client_secret
GITHUB_CALLBACK_URL=https://api.wuh.site/auth/github/callback

# Admin
ROOT_GITHUB_IDS=123456789,987654321

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h

# Logging
LOG_LEVEL=info

# Sentry
SENTRY_DSN=https://your_sentry_dsn_here
