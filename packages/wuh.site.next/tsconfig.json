{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "ES2021"
    ],
    "jsx": "preserve",
    "noEmit": true,
    "declaration": false,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@wuh.site/components/*": [
        "../components/*"
      ],
      "@wuh.site/shared-contracts": [
        "../shared-contracts/src/index.ts"
      ],
      "@wuh.site/shared-contracts/*": [
        "../shared-contracts/src/*"
      ],
      "@wuh.site/config/*": [
        "../config/*"
      ],
      "@wuh.site/hooks/*": [
        "../hooks/*"
      ]
    },
    "allowJs": true
  },
  "include": [
    "./dist/wuh.site.next/types/**/*.ts",
    "app/**/*",
    "components/**/*",
    "next-env.d.ts",
    "types/**/*",
    "./dist/wuh.site.next-dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "dist"
  ]
}
